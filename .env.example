# Provider keys for OpenArtifact itself (used by `pnpm smoke` and manual testing).
# Tests never use these; they run on recorded fixtures.
# At least one real provider is needed to try the app for real. Ollama needs no key.
#
# `pnpm smoke --provider <id>` makes one real streaming request through the
# adapter and prints the reply, or `[skip] <id>` when the provider's key is
# missing. Keys are read from this file or the environment and are never
# printed. Optional per-provider overrides: SMOKE_<ID>_MODEL and
# SMOKE_<ID>_BASE_URL, e.g. SMOKE_OPENAI_COMPATIBLE_BASE_URL points the
# openai-compatible adapter at Groq, Together, DeepSeek, OpenRouter, vLLM,
# LM Studio or LocalAI (any /v1/chat/completions endpoint works).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# TypeSafe (Jev) key for the commit review agent (scripts/jev-review.mjs).
TYPESAFE_API_KEY=
