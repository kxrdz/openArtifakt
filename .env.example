# Provider keys for OpenArtifact itself (used by `pnpm smoke` and manual testing).
# Tests never use these; they run on recorded fixtures.
# At least one real provider is needed to try the app for real. Ollama needs no key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
