# OpenArtifact configuration reference.
#
# Copy this file to `.env` only if you want to source it into your shell —
# `set -a; source .env; set +a` — before starting. The server itself does
# NOT auto-load `.env`; it reads the process environment. `pnpm smoke` and
# `scripts/jev-review.mjs` do read `.env` from the repo root.
#
# Everything below is optional. Each variable lists its default, so a single
# `pnpm dev` works out of the box (fake provider aside).

# ---------------------------------------------------------------------------
# Server configuration
#
# These set how the OpenArtifact server behaves. Defaults come from
# `apps/server/src/config.ts` (see PROVIDER_DEFAULTS there for the per-provider
# model / base URL / key ref / context window / capability table).
# ---------------------------------------------------------------------------

# Provider adapter: openai-compatible | anthropic | gemini | ollama | 9router
# (default: openai-compatible)
OPENARTIFACT_PROVIDER=

# Model name for the chosen provider (default: per provider, e.g. gpt-4o-mini,
# claude-3-5-haiku-latest, gemini-2.0-flash, llama3.2, cc/claude-sonnet-4-5).
OPENARTIFACT_MODEL=

# API base URL (default: per provider). Point openai-compatible at any
# /v1/chat/completions endpoint (Groq, Together, DeepSeek, OpenRouter, vLLM,
# LM Studio, LocalAI).
#
# 9Router preset: OPENARTIFACT_PROVIDER=9router uses the OpenAI-compatible
# gateway (base URL http://localhost:20128/v1, auth optional). Override the
# model with any id from `curl http://localhost:20128/v1/models`.
OPENARTIFACT_BASE_URL=

# Name of the environment variable that holds the API key (default: per
# provider, e.g. OPENAI_API_KEY). The server reads process.env[this name] and
# never stores or logs the key itself.
OPENARTIFACT_API_KEY_REF=

# Approval mode for risky actions: ask | auto-edit | full-auto
# (default: ask — reads run automatically; edits, writes and commands ask)
OPENARTIFACT_APPROVAL_MODE=

# Absolute workspace root the agent's tools operate in
# (default: the directory the server is launched from)
OPENARTIFACT_WORKSPACE_ROOT=

# Token window used for context management (default: per provider, e.g.
# 128000 for openai-compatible, 200000 for anthropic, 8192 for ollama).
OPENARTIFACT_CONTEXT_WINDOW=

# Capability overrides (default: per provider; 1/0, true/false, yes/no, on/off).
# Native tool calling (when false, a text <tool_call> protocol is used instead).
OPENARTIFACT_NATIVE_TOOLS=
# Streaming tool arguments (when false, tool args arrive as one JSON block).
OPENARTIFACT_STREAMING_TOOL_ARGS=
# Vision support flag.
OPENARTIFACT_VISION=

# Set to 1 to run the key-free scripted replay (a fake provider over a seeded
# temp workspace). This is what the test suite and screenshots use.
# (default: false)
OPENARTIFACT_FAKE_PROVIDER=

# Port the server binds on (always 127.0.0.1). (default: 4318)
PORT=

# ---------------------------------------------------------------------------
# Provider keys + smoke
#
# At least one real provider key is needed to chat for real; Ollama needs no
# key. `pnpm smoke --provider <id>` reads these from `.env` or the environment
# and makes one real streaming request per provider, printing `[skip]` when the
# key is missing. Keys are never printed. Tests never use these — they run on
# recorded fixtures.
# ---------------------------------------------------------------------------

# openai-compatible (also used by the openai-compatible adapter default)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Any /v1/chat/completions endpoint, e.g. OpenRouter:
OPENROUTER_API_KEY=

# 9Router gateway (optional — only needed when requireApiKey=true):
NINEROUTER_KEY=

# Local model; no key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional per-provider smoke overrides (mirror --model / --base-url flags):
#   SMOKE_<ID>_MODEL, SMOKE_<ID>_BASE_URL  (ID with - as _, e.g.
#   SMOKE_OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1)

# TypeSafe (Jev) key for the commit review agent (scripts/jev-review.mjs).
TYPESAFE_API_KEY=
